<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="Account Preferences"
        app:iconSpaceReserved="false"
        app:layout="@layout/preference_category_custom">
        <Preference
            android:key="account_profile"
            android:title="Name, Email, Class, etc"
            android:summary="User Profile"
            app:iconSpaceReserved="false" />
        <CheckBoxPreference
            android:key="privacy_anonymous_posting"
            android:title="Privacy Setting"
            android:summary="Posting your records anonymously"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Additional Settings"
        app:iconSpaceReserved="false"
        app:layout="@layout/preference_category_custom">
        <ListPreference
            android:key="unit_preference"
            android:title="Unit Preference"
            android:summary="Select the units"
            android:defaultValue="metric"
            android:entries="@array/unit_entries"
            android:entryValues="@array/unit_values"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Comments"
        app:iconSpaceReserved="false"
        app:layout="@layout/preference_category_custom">
        <EditTextPreference
            android:key="comments_input"
            android:title="Comments"
            android:summary="Please enter your comments"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Misc."
        app:iconSpaceReserved="false"
        app:layout="@layout/preference_category_custom">
        <Preference
            android:key="webpage_link"
            android:title="Webpage"
            android:summary="https://www.sfu.ca/computing.html"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

</PreferenceScreen>